<https://zann-37.github.io/graph/kampus> {

    ex:dedy_arisandi a ex:Lecturer ;
        foaf:name "Dedy Arisandi"@id ;
        ex:bernaung_di ex:teknologi_informasi ;
        ex:mengajar ex:manajemen_basis_data .

    ex:ida a ex:Lecturer ;
        foaf:name "Muhammad Isa Dadi Hasibuan"@id ;
        ex:bernaung_di ex:teknologi_informasi ;
        ex:mengajar ex:web_semantik .

    ex:ivan_jaya a ex:Lecturer ;
        foaf:name "Ivan Jaya"@id ;
        ex:bernaung_di ex:teknologi_informasi ;
        ex:mengajar ex:pemrograman_web .

    ex:izyan a ex:Student ;
        foaf:name "Muhammad Izyan"@id ;
        ex:bernaung_di ex:teknologi_informasi ;
        ex:mengambil ex:manajemen_basis_data, ex:web_semantik .

    ex:yazri a ex:Student ;
        foaf:name "Yazri Khoiri"@id ;
        ex:bernaung_di ex:teknologi_informasi ;
        ex:mengambil ex:pemrograman_web, ex:web_semantik ;
