}

<https://zann-37.github.io/graph/fakultas> {

    ex:teknologi_informasi
        ex:memilikiDosen ex:ida, ex:dedy_arisandi, ex:ivan_jaya ;
        ex:memilikiMahasiswa ex:izyan, ex:yazri ;
        ex:memilikiMataKuliah ex:web_semantik, ex:manajemen_basis_data, ex:pemrograman_web ;
        ex:memilikiProgram ex:teknologi_informasi_program ;
